# Gluetun configuration for ProtonVPN WireGuard
# This file is sourced by gluetun.container via EnvironmentFile

# VPN Provider settings
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard

# WireGuard credentials (REQUIRED - get from ProtonVPN dashboard)
WIREGUARD_PRIVATE_KEY=your_private_key_here
SERVER_COUNTRIES=Switzerland

# Port forwarding: gluetun requests port from Proton, opens in firewall, then calls qBittorrent API
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn
VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'wget -O- --retry-connrefused --post-data "json={\"listen_port\":{{PORTS}}}" http://127.0.0.1:24953/api/v2/app/setPreferences'

# Kill switch: blocks all non-VPN traffic in shared namespace
FIREWALL=on

# Allow inbound to published web UI ports
FIREWALL_INPUT_PORTS=7878,8989,8686,9696,6767,5055,24953,32400

# Optional: allow LAN access (e.g., local NAS)
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

# Optional: enable debug logging
# FIREWALL_DEBUG=1
# LOG_LEVEL=debug