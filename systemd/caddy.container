[Unit]
Description=Caddy reverse proxy
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
Network=arr.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=/data/arr/config/caddy:/etc/caddy:ro,Z
Volume=/data/arr/config/caddy/data:/data:Z
AutoUpdate=registry
Timezone=local

[Service]
Restart=always

[Install]
WantedBy=default.target