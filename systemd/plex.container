[Unit]
Description=Plex Media Server Container Service
After=network-online.target

[Container]
Image=linuxserver/plex:latest
ContainerName=plex
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/plex:/config:Z
Volume=data/arr/media/movies:/movies:Z
Volume=/data/arr/media/kidsmovies:/kid-movies:Z
Volume=/data/arr/media/tvshows:/tvshows:Z
Volume=/data/arr/media/kidstv:/kidstv:Z
Volume=/data/arr/media/music:/music:Z
Volume=/data/arr/tmp/plex-transcode:/transcode:Z
Timezone=local

AddDevice=/dev/dri

PublishPort=32400:32400
CPUQuota=200%
Memory=4G
Network=arr

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:32400/web || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target