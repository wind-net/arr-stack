[Unit]
Description=Lidarr (Music)

[Container]
ContainerName=lidarr
Image=lscr.io/linuxserver/lidarr:latest
Network=mynet.network

# Resource limits
PodmanArgs=--userns=keep-id --memory=1g --cpus=4

Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=COMPlus_EnableDiagnostics=0
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=UTC

Volume=/data/arr/config/lidarr:/config
Volume=/data/arr/media/music:/music
Volume=/data/arr/downloads:/downloads
Volume=/data/arr/tmp/lidarr:/tmp

Timezone=local

AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target