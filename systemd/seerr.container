[Unit]
Description=Seerr Container Service
Requires=gluetun.service
After=gluetun.service

[Container]
User=0:0
Image=ghcr.io/seerr-team/seerr:latest
ContainerName=seerr
Pod=arr.pod
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/seerr:/app/config:rw,Z
Timezone=local
PodmanArgs=--cpus=2
Memory=1G
PidsLimit=200

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=node -e "fetch('http://127.0.0.1:5055/api/v1/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

[Service]
Restart=always

[Install]
WantedBy=default.target