[Unit]
Description=Seerr Container Service
After=network-online.target

[Container]
Image=ghcr.io/seerr-team/seerr:latest
ContainerName=seerr
Environment=PUID=0
Environment=PGID=0
Volume=/etc/localtime:/etc/localtime:ro
Volume=/data/arr/config/seerr:/config:Z
Timezone=local

PublishPort=5055:5055/tcp
CPUQuota=200%
Memory=1G
Network=arr

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:8989 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
