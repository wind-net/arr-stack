[Unit]
Description=Prowlarr Container Service
Requires=gluetun.service
After=gluetun.service

[Container]
Image=ghcr.io/hotio/prowlarr:latest
ContainerName=prowlarr
Pod=arr.pod
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/prowlarr:/config:Z
Volume=/data/arr/tmp/prowlarr:/tmp:Z
Timezone=local
Memory=512m
PodmanArgs=--cpus=0.5
PidsLimit=200

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:9696 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target