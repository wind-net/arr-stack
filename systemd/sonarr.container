[Unit]
Description=Sonarr Container Service
After=network-online.target

[Container]
Image=ghcr.io/hotio/sonarr:latest
ContainerName=sonarr
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/sonarr:/config:Z
Volume=/data/arr/tmp/sonarr:/tmp:Z
Volume=/data/arr/downloads:/downloads:z
Volume=/data/arr/media/tvshows:/tv:Z
Timezone=local

PublishPort=8989:8989
CPUQuota=200%
Memory=2G
Network=arr

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:8989 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
