[Unit]
Description=Bazarr Container Service
Requires=gluetun.service
After=gluetun.service

[Container]
Image=ghcr.io/hotio/bazarr:latest
ContainerName=bazarr
Pod=arr.pod
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/bazarr:/config:Z
Volume=/data/arr/media:/data:z
Timezone=local
Memory=512m
PodmanArgs=--cpus=0.5
PidsLimit=200

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:6767 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target