[Unit]
Description=Bazarr Container Service
After=network-online.target

[Container]
Image=ghcr.io/hotio/bazarr:latest
ContainerName=bazarr
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/bazarr:/config:Z
Volume=/data/arr/data:/data:z
PublishPort=6767:6767
Network=arr
Timezone=local

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:6767 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
