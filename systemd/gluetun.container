[Unit]
Description=Gluetun VPN (ProtonVPN WireGuard)
After=arr-pod.service
Requires=arr-pod.service

[Container]
ContainerName=gluetun
Image=docker.io/qmcgaw/gluetun:v3
Pod=arr.pod
AddCapability=NET_ADMIN
AddDevice=/dev/net/tun
# All configuration loaded from env file
EnvironmentFile=/data/arr/config/gluetun/gluetun.env
# Wait for VPN to be fully up before starting other services
Notify=healthy
HealthCmd=/gluetun-entrypoint healthcheck
HealthInterval=10s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always

[Install]
WantedBy=default.target