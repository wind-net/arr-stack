[Unit]
Description=Radarr Container Service
After=network-online.target

[Container]
Image=ghcr.io/hotio/radarr:latest
ContainerName=radarr
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/radarr:/config:Z
Volume=/data/arr/tmp/radarr:/tmp:Z
Volume=/data/arr/downloads:/downloads:z
Volume=/data/arr/media/movies:/movies:Z
Timezone=local

PublishPort=7878:7878
CPUQuota=200%
Memory=2G
Network=arr

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:7878 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
