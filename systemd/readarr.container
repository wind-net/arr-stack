[Unit]
Description=Readarr Container Service
After=network-online.target

[Container]
Image=ghcr.io/hotio/readarr:latest
ContainerName=readarr
Environment=PUID=0
Environment=PGID=0
Volume=/data/arr/config/readarr:/config:Z
Volume=/data/arr/tmp/readarr:/tmp:Z
Volume=/data/arr/downloads:/downloads:z
Volume=/data/arr/media/books:/books:Z

Timezone=local

PublishPort=8787:8787
CPUQuota=200%
Memory=2G
Network=arr

AutoUpdate=registry
Label=io.containers.autoupdate=registry

HealthCmd=curl -f http://localhost:8787 || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target