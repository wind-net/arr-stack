[Unit]
Description=Prowlarr (Indexers)

[Container]
ContainerName=prowlarr
Image=lscr.io/linuxserver/prowlarr:latest
Network=mynet.network

# Resource limits
PodmanArgs=--memory=512m --cpus=4

Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=UTC

Volume=%h/arr-config/prowlarr:/config:Z
Volume=%h/arr-downloads/incomplete/tmp-prowlarr:/tmp:Z

AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
