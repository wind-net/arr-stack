[Unit]
Description=Gluetun VPN (AirVPN WireGuard)

[Container]
ContainerName=gluetun
Image=docker.io/qmcgaw/gluetun:latest
Network=mynet.network

# Resource limits
# SELinux: rootless containers are blocked from opening /dev/net/tun unless
# policy/booleans allow it. This disables SELinux labeling for this container.
# Avoid WireGuard selecting IPv6 endpoints when the container runtime/network is IPv4-only.
PodmanArgs=--security-opt label=disable --sysctl net.ipv6.conf.all.disable_ipv6=1 --memory=512m --cpus=1

# Rootless WireGuard needs the tun device and NET_ADMIN in the container namespace.
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN

# Allow ICMP healthchecks (otherwise it falls back to DNS-only checks).
AddCapability=NET_RAW

EnvironmentFile=%h/.config/containers/gluetun-airvpn.env

Volume=%h/arr-config/gluetun:/gluetun:Z

AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
