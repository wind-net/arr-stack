[Unit]
Description=FlareSolverr

[Container]
ContainerName=flaresolverr
Image=ghcr.io/flaresolverr/flaresolverr:latest
Network=mynet.network

# Resource limits (Chromium needs more RAM for Cloudflare challenges)
PodmanArgs=--memory=2g --cpus=2

Environment=TZ=UTC
Environment=LOG_LEVEL=info
Environment=BROWSER_TIMEOUT=120000
Environment=HEADLESS=true

AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
