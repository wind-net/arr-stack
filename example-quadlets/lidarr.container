[Unit]
Description=Lidarr (Music)

[Container]
ContainerName=lidarr
Image=lscr.io/linuxserver/lidarr:latest
Network=mynet.network

# Resource limits
PodmanArgs=--userns=keep-id --memory=1g --cpus=4

Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=COMPlus_EnableDiagnostics=0
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=UTC

Volume=%h/arr-config/lidarr:/config:Z
Volume=%h/arr-downloads/media/music:/music:z
Volume=%h/arr-downloads:/downloads:z
Volume=%h/arr-downloads/incomplete/tmp-lidarr:/tmp:Z

AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
