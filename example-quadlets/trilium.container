[Unit]
Description=Trilium Notes - Personal Knowledge Base

[Container]
Image=docker.io/triliumnext/trilium:latest
ContainerName=trilium

# Bind mount for persistent data
Volume=%h/trilium-data:/home/node/trilium-data:Z

# Port mapping
Network=mynet.network

# Resource limits
PodmanArgs=--memory=512m --cpus=1

# Match container user to your UID/GID for proper permissions
Environment=USER_UID=1000
Environment=USER_GID=1000

# Auto-update support
AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
