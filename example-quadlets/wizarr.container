[Unit]
Description=Wizarr (Jellyfin Invite Manager)

[Container]
ContainerName=wizarr
Image=ghcr.io/wizarrrr/wizarr:latest
Network=mynet.network

# Resource limits
PodmanArgs=--memory=512m --cpus=2

Environment=TZ=UTC

Volume=%h/arr-config/wizarr:/data:Z

AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
