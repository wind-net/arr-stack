[Unit]
Description=Sonarr (TV)

[Container]
ContainerName=sonarr
Image=lscr.io/linuxserver/sonarr:latest
Network=mynet.network

# Resource limits
PodmanArgs=--userns=keep-id --memory=1g --cpus=4

Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=COMPlus_EnableDiagnostics=0
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=UTC

Volume=%h/arr-config/sonarr:/config:Z
Volume=%h/arr-downloads:/downloads:z
Volume=%h/arr-downloads/incomplete/tmp-sonarr:/tmp:Z
Volume=%h/arr-media/tv:/tv:Z

AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
